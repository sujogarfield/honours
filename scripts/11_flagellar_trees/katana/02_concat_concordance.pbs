#!/bin/bash
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -N flag_concat

# Runs after every gene tree in 01_gene_trees.pbs has finished.
#  1. Concatenated (partitioned) flagellar tree, ModelFinder per gene, 1000 UFBoot.
#  2. Gene + site concordance factors (gCF, sCFL) on the flagellar tree.
#  3. The same concordance factors on the GTDB species tree: for each species
#     branch, how many flagellar genes / sites support it.
#  4. Flagellar tree vs GTDB comparison (compare_to_gtdb.py).
#  5. HGT candidate screen (screen_hgt_candidates.py).

set -euo pipefail
cd "$PBS_O_WORKDIR"
# env binaries on PATH directly -- no conda activation, so CONDA_BASE isn't needed
export PATH="$PBS_O_WORKDIR/.katana_env/bin:$PATH"

D=gene_order/flagellar_trees
C=$D/concordance
mkdir -p "$D/concat" "$C"

# Each step is skipped if its output already exists, so a failed job can simply
# be resubmitted (IQ-TREE refuses to overwrite a finished run without -redo).
[ -s "$D/concat/concat.treefile" ] || \
    iqtree2 -p "$D/trimmed" -m MFP -B 1000 -T "$NCPUS" --prefix "$D/concat/concat"

cat "$D"/gene_trees/*.treefile > "$C/loci.treefile"

# IQ-TREE >= 2.4 won't combine --gcf and --scfl in one run, so gene and site
# concordance are separate. best_model.nex fixes the per-gene models found
# above, so sCFL doesn't rerun ModelFinder.
for REF in flagellar:"$D/concat/concat.treefile" gtdb:"$D/gtdb_ref_pruned.nwk"; do
    NAME=${REF%%:*}; TREE=${REF#*:}
    [ -s "$C/${NAME}_gcf.cf.stat" ] || \
        iqtree2 -t "$TREE" --gcf "$C/loci.treefile" --prefix "$C/${NAME}_gcf"
    [ -s "$C/${NAME}_scfl.cf.stat" ] || \
        iqtree2 -te "$TREE" -p "$D/concat/concat.best_model.nex" --scfl 100 \
            -T "$NCPUS" --prefix "$C/${NAME}_scfl"
done

python scripts/11_flagellar_trees/compare_to_gtdb.py
python scripts/11_flagellar_trees/screen_hgt_candidates.py

echo "=== done ==="
