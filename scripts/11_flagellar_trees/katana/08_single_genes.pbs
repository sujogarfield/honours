#!/bin/bash
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -N flag_single_gene

# PBS array, one element per row of single/cases.tsv (gene test).
set -euo pipefail
cd "$PBS_O_WORKDIR"
export PATH="$PBS_O_WORKDIR/.katana_env/bin:$PATH"
read -r CASE GENE MODEL _ < <(sed -n "$((PBS_ARRAY_INDEX + 1))p" gene_order/flagellar_trees/single/cases.tsv)
bash scripts/11_flagellar_trees/katana/single_one.sh gene "$CASE" "$GENE" "$MODEL" "$NCPUS"
