#!/bin/bash
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -N fp_concat

# Stage 2b, after every gene tree: partitioned concatenated tree, gCF + sCFL on
# the concatenated and GTDB trees, comparison with GTDB, HGT screen + shortlist,
# tanglegram
# (as scripts/11_flagellar_trees/katana/02_concat_concordance.pbs, plus a fixed seed).

set -euo pipefail
cd "$PBS_O_WORKDIR"
source synphy/katana/common.sh
: "${RUN:?set RUN=<run dir>}"
D=$RUN/trees
C=$D/concordance
mkdir -p "$D/concat" "$C"
[ -s "$D/concat/concat.treefile" ] || \
    iqtree2 -p "$D/trimmed" -m MFP -B 1000 -T "$NCPUS" --seed 1 --prefix "$D/concat/concat"
cat "$D"/gene_trees/*.treefile > "$C/loci.treefile"
for REF in flagellar:"$D/concat/concat.treefile" gtdb:"$D/gtdb_ref_pruned.nwk"; do
    NAME=${REF%%:*}; TREE=${REF#*:}
    [ -s "$C/${NAME}_gcf.cf.stat" ] || iqtree2 -t "$TREE" --gcf "$C/loci.treefile" --prefix "$C/${NAME}_gcf"
    [ -s "$C/${NAME}_scfl.cf.stat" ] || iqtree2 -te "$TREE" -p "$D/concat/concat.best_model.nex" \
        --scfl 100 -T "$NCPUS" --seed 1 --prefix "$C/${NAME}_scfl"
done
FLAG_DIR="$D" python scripts/11_flagellar_trees/compare_to_gtdb.py
$FP hgt-screen "$RUN"       # gene-tree branches that contradict GTDB
$FP hgt-shortlist "$RUN"    # thesis shortlist rule -> hgt_shortlist.tsv
cp "$D/hgt_shortlist.tsv" "$RUN/report/" 2>/dev/null || true
$FP report "$RUN"
echo "=== stage 2 done: $RUN/report/ ==="
