#!/bin/bash
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -N fp_eggnog_db

# One-off: downloads the eggNOG 5.0.2 database (~50 GB) for eggNOG-mapper 2.1.13
# into a shared folder, so everyone in the group uses one copy.
#   qsub -v EGGNOG_DATA_DIR=/srv/scratch/$USER/eggnog_data flagpipe/katana/download_eggnog.pbs
# Needs internet on the compute node. If Katana compute nodes have none, run the
# same two lines on the login node inside `screen` instead.

set -euo pipefail
cd "$PBS_O_WORKDIR"
source flagpipe/katana/common.sh
EGGNOG_DATA_DIR=${EGGNOG_DATA_DIR:-/srv/scratch/$USER/eggnog_data}
mkdir -p "$EGGNOG_DATA_DIR"
download_eggnog_data.py -y --data_dir "$EGGNOG_DATA_DIR"
ls -la "$EGGNOG_DATA_DIR"
