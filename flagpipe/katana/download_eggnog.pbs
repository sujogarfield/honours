#!/bin/bash
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -N fp_eggnog_db

# One-off: downloads the eggNOG 5.0.2 database (~50 GB) for eggNOG-mapper 2.1.13.
#   qsub flagpipe/katana/download_eggnog.pbs              # -> /srv/scratch/$USER/eggnog_data
# or, if compute nodes have no internet, on the login node inside `screen`:
#   bash flagpipe/katana/download_eggnog.pbs
# The files are fetched with wget from eggnog5.embl.de: download_eggnog_data.py
# in 2.1.13 still points at eggnogdb.embl.de, which no longer resolves
# (checked on Katana, 2026-11-02), and it reports "Finished." even when every
# download fails.

set -euo pipefail
EGGNOG_DATA_DIR=${EGGNOG_DATA_DIR:-/srv/scratch/$USER/eggnog_data}
URL=http://eggnog5.embl.de/download/emapperdb-5.0.2
mkdir -p "$EGGNOG_DATA_DIR"
cd "$EGGNOG_DATA_DIR"
rm -f eggnog.db.gz eggnog.taxa.tar.gz eggnog_proteins.dmnd.gz   # empty leftovers of a failed try

[ -s eggnog.db ]            || { wget -nv "$URL/eggnog.db.gz" && gunzip eggnog.db.gz; }
[ -s eggnog.taxa.db ]       || { wget -nv "$URL/eggnog.taxa.tar.gz" && tar -zxf eggnog.taxa.tar.gz && rm eggnog.taxa.tar.gz; }
[ -s eggnog_proteins.dmnd ] || { wget -nv "$URL/eggnog_proteins.dmnd.gz" && gunzip eggnog_proteins.dmnd.gz; }

for f in eggnog.db eggnog.taxa.db eggnog_proteins.dmnd; do
  [ -s "$f" ] || { echo "FAILED: $EGGNOG_DATA_DIR/$f is missing or empty"; exit 1; }
done
ls -lh "$EGGNOG_DATA_DIR"
echo "eggNOG database OK"
