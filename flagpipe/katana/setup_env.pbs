#!/bin/bash
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -N fp_env

# One-off: builds the shared flagpipe conda env from env.yml. Too slow for the
# login node. Run from the repo root:  qsub flagpipe/katana/setup_env.pbs

set -euo pipefail
cd "$PBS_O_WORKDIR"
source flagpipe/katana/common.sh
[ -f "$CONDA_BASE/etc/profile.d/conda.sh" ] || { echo "No conda at $CONDA_BASE -- install Miniforge there first (see flagpipe/README.md)"; exit 1; }
source "$CONDA_BASE/etc/profile.d/conda.sh"
conda env create -p "$FLAGPIPE_ENV" -f flagpipe/katana/env.yml \
  || conda env update -p "$FLAGPIPE_ENV" -f flagpipe/katana/env.yml
orthofinder -h | head -3 || true
emapper.py --version
iqtree2 --version | head -1
python -c "import ete3, numpy, Bio, matplotlib; print('python deps OK')"
