#!/bin/bash
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -N fp_au

# Stage 3: one element per shortlisted HGT candidate ($RUN/trees/au/candidates.txt).
# AU test on the concatenated alignment (all CPUs), then on each informative gene
# (4 at a time, 2 threads each). As scripts/11_flagellar_trees/katana/03_au_tests.pbs.

set -euo pipefail
cd "$PBS_O_WORKDIR"
source flagpipe/katana/common.sh
: "${RUN:?set RUN=<run dir>}"
D=$RUN/trees
K=flagpipe/katana
CAND=$(sed -n "${PBS_ARRAY_INDEX}p" "$D/au/candidates.txt")
echo "=== $CAND on $(hostname) ==="
bash "$K/au_one.sh" "$D" "$CAND" concat - "$NCPUS"
awk -v c="$CAND" '{print c, $1, $2}' "$D/au/$CAND/genes.tsv" \
    | xargs -P 4 -n 3 sh -c 'bash '"$K"'/au_one.sh "'"$D"'" "$0" "$1" "$2" 2'
echo "=== done $CAND ==="
