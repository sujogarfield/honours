#!/bin/bash
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -N fp_au_summary

# After every AU element has ended (afterany, so one failed candidate doesn't block the rest).
set -euo pipefail
cd "$PBS_O_WORKDIR"
source flagpipe/katana/common.sh
: "${RUN:?set RUN=<run dir>}"
$FP hgt-summary "$RUN"
cp "$RUN/trees/hgt_shortlist.tsv" "$RUN/trees/au/au_summary.tsv" "$RUN/report/"
echo "=== stage 3 done: $RUN/report/au_summary.tsv ==="
